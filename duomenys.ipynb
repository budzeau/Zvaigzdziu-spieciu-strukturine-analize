   "source": [
    "from astroquery.vizier import Vizier\n",
    "\n",
    "Vizier.ROW_LIMIT = -1\n",
    "v = Vizier(columns=['**'])\n",
    "catalog = v.get_catalogs('J/A+A/686/A42/members')\n",
    "members = catalog['J/A+A/686/A42/members'].to_pandas()\n",
    "members.to_csv(\"duomenys.csv\", index=False)"
   ]
  }
